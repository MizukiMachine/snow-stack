{
  "name": "snow-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "cap": "npx -y node@22 node_modules/@capacitor/cli/bin/capacitor",
    "android:doctor": "npm run cap -- doctor",
    "android:sync": "npm run build && npm run cap -- sync android",
    "android:run": "npm run build && npm run cap -- run android",
    "android:open": "npm run build && npm run cap -- open android",
    "android:build": "npm run android:sync && cd android && ./gradlew :app:assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.41",
    "@types/three": "^0.160.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
